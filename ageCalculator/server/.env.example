# Copy to server/.env and adjust.

# Port for the API (and for the built app in production).
PORT=5050

# Local MongoDB, MongoDB Atlas, or any MongoDB-compatible server.
# Use 127.0.0.1 rather than localhost: Node prefers IPv6 for "localhost" and
# MongoDB listens on IPv4 by default.
MONGODB_URI=mongodb://127.0.0.1:27017/nepali_age_calculator

# Time zone the API uses for "today" in the ages it returns.
# (The browser uses the device's own date for what it shows.)
APP_TIME_ZONE=Asia/Kathmandu

# Only needed if the client is hosted on a different domain, comma-separated.
# CLIENT_ORIGIN=https://umer.example.com

# NODE_ENV=production
